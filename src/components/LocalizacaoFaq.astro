---
import dentare from '../data/dentare.json';
import Icon from './Icon.astro';

const { clinic, locationSection: location, faqSection, faq } = dentare;
const whatsappUrl = new URL(clinic.contact.whatsappBaseUrl);
whatsappUrl.searchParams.set('text', clinic.contact.defaultMessage);
---

<section id="localizacao" aria-labelledby="location-title" class="border-b border-white/5 bg-surface/40 py-20 sm:py-24 lg:py-28">
  <div class="container grid min-w-0 gap-16 lg:grid-cols-2 lg:gap-14 xl:gap-20">
    <div class="min-w-0">
      <p class="text-eyebrow uppercase text-surgical">{location.eyebrow}</p>
      <h2 id="location-title" class="mt-5 text-display-lg text-ivory">{location.title}</h2>
      <p class="mt-5 text-sm leading-loose text-ivory-muted">{location.description}</p>
      <div class="mt-8 space-y-6">
        <address class="flex items-start gap-3 text-sm not-italic leading-loose text-ivory"><Icon name="pin" class="mt-1 h-5 w-5 text-champagne" />{clinic.address.full}</address>
        <div class="rounded-2xl border border-white/5 bg-surface p-5">
          <p class="text-xs font-semibold text-champagne-light">{location.referencesLabel}</p>
          <ul class="mt-3 space-y-2">
            {location.references.map((reference) => <li class="flex items-start gap-2 text-xs leading-relaxed text-ivory-muted"><Icon name="check" class="mt-0.5 h-3.5 w-3.5 text-surgical" />{reference}</li>)}
          </ul>
        </div>
        <div class="flex items-start gap-3">
          <Icon name="clock" class="mt-0.5 h-5 w-5 text-champagne" />
          <div class="min-w-0 text-sm leading-loose text-ivory-muted">
            <p class="mb-2 font-semibold text-ivory">{location.hoursLabel}</p>
            {clinic.hours.schedule.map((schedule) => <p>{schedule.days}: {schedule.hours}</p>)}
          </div>
        </div>
        <a href={location.directionsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 max-w-full items-center justify-center gap-3 rounded-2xl bg-champagne px-5 py-3 text-sm font-semibold leading-relaxed text-navy-950 transition-colors hover:bg-champagne-light">
          <span>{location.directionsLabel}</span><Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>
      <figure class="mt-8 overflow-hidden rounded-3xl border border-white/10 bg-surface">
        <div class="relative aspect-[4/3] w-full sm:aspect-[16/10]">
          <iframe src={location.mapEmbedUrl} title={location.mapTitle} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen class="absolute inset-0 h-full w-full border-0 grayscale-[0.7] transition-[filter] duration-300 hover:grayscale-0 motion-reduce:transition-none"></iframe>
        </div>
        <figcaption class="border-t border-white/5 px-5 py-3 text-[11px] leading-relaxed text-ivory-muted">{location.mapCaption}</figcaption>
      </figure>
    </div>

    <div id="duvidas" class="min-w-0" role="region" aria-labelledby="faq-title">
      <p class="text-eyebrow uppercase text-champagne">{faqSection.eyebrow}</p>
      <h2 id="faq-title" class="mt-5 text-display-lg text-ivory">{faqSection.title}</h2>
      <p class="mt-5 text-sm leading-loose text-ivory-muted">{faqSection.description}</p>
      <div class="mt-8 space-y-3">
        {faq.map((item) => (
          <details name="dentare-faq" class="faq-item group overflow-hidden rounded-2xl border border-white/10 bg-slate-900/50 transition-colors duration-300 open:border-champagne/25 open:bg-surface motion-reduce:transition-none">
            <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-4 rounded-2xl px-5 py-5 text-sm font-medium leading-relaxed text-ivory transition-colors hover:text-champagne-light sm:px-6 [&::-webkit-details-marker]:hidden">
              <span class="min-w-0">{item.question}</span>
              <Icon name="chevron" class="h-4 w-4 text-champagne transition-transform duration-300 group-open:rotate-180 motion-reduce:transition-none" />
            </summary>
            <div class="px-5 pb-6 sm:px-6"><p class="border-t border-white/5 pt-4 text-sm leading-loose text-ivory-muted">{item.answer}</p></div>
          </details>
        ))}
      </div>
      <div class="mt-8 rounded-3xl border border-champagne/15 bg-gradient-to-br from-champagne/5 to-transparent p-6 sm:p-8">
        <Icon name="message" class="h-6 w-6 text-champagne" />
        <h3 class="mt-4 text-2xl text-ivory">{faqSection.contactTitle}</h3>
        <p class="mt-3 text-sm leading-loose text-ivory-muted">{faqSection.contactDescription}</p>
        <a href={whatsappUrl.href} class="mt-5 inline-flex min-h-11 items-center gap-3 text-sm font-semibold text-champagne-light transition-colors hover:text-ivory">{faqSection.contactLabel}<Icon name="arrow" class="h-4 w-4" /></a>
      </div>
    </div>
  </div>
</section>

<style>
  @supports (interpolate-size: allow-keywords) {
    .faq-item { interpolate-size: allow-keywords; }
    .faq-item::details-content {
      block-size: 0;
      overflow: hidden;
      transition: block-size 300ms ease, content-visibility 300ms ease;
      transition-behavior: allow-discrete;
    }
    .faq-item[open]::details-content { block-size: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-item::details-content { transition: none; }
  }
</style>
