---
import dentare from '../data/dentare.json';
import Icon from './Icon.astro';

const { clinic, testimonialsSection: section, testimonials } = dentare;
---

<section id="depoimentos" aria-labelledby="testimonials-title" class="relative isolate py-20 sm:py-24 lg:py-28">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-surface/40 to-background"></div>
  <div class="container">
    <div class="max-w-3xl">
      <p class="text-eyebrow uppercase text-champagne">{section.eyebrow}</p>
      <h2 id="testimonials-title" class="mt-5 text-display-lg text-ivory">{section.title}</h2>
      <div class="mt-6 inline-flex max-w-full flex-wrap items-center gap-x-3 gap-y-2 rounded-2xl border border-champagne/20 bg-champagne/5 px-4 py-3 text-xs leading-relaxed text-slate-200 sm:text-sm">
        <span class="inline-flex items-center gap-2 font-semibold text-champagne-light"><Icon name="star" class="h-4 w-4" />{section.ratingPrefix} {clinic.google.rating} {clinic.google.ratingLabel}</span>
        <span aria-hidden="true" class="text-champagne/50">•</span>
        <span>{clinic.google.verifiedCountLabel}</span>
      </div>
      <p class="mt-5 text-sm leading-loose text-slate-200">{section.description}</p>
    </div>

    <div class="mt-10 grid min-w-0 gap-5 lg:mt-12 lg:grid-cols-3 lg:gap-6">
      {testimonials.map((testimonial) => (
        <figure class="relative flex min-w-0 flex-col overflow-hidden rounded-[2rem] border border-white/10 bg-gradient-to-br from-surface-raised/60 to-surface/60 p-6 shadow-premium backdrop-blur-sm sm:p-8">
          <span aria-hidden="true" class="pointer-events-none absolute right-6 top-0 font-display text-[11rem] leading-none text-champagne/10">“</span>
          <div class="relative flex min-h-12 items-center gap-1 text-champagne">
              {Array.from({ length: testimonial.rating }, () => <Icon name="star" class="h-3.5 w-3.5" />)}
              <span class="sr-only">{testimonial.rating} {section.ratingAccessibleLabel}</span>
          </div>
          <blockquote class="relative mb-8 mt-5 text-sm leading-loose text-slate-200"><p>{testimonial.quote}</p></blockquote>
          <figcaption class="relative mt-auto border-t border-white/10 pt-6">
            <div class="flex items-center gap-3">
              <span aria-hidden="true" class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-champagne/40 bg-gradient-to-br from-champagne/20 to-champagne/5 font-display text-sm tracking-wide text-champagne-light">{testimonial.initials}</span>
              <p class="min-w-0 text-sm font-semibold text-ivory">{testimonial.name}</p>
            </div>
            <span class="mt-4 inline-flex max-w-full items-start gap-1.5 rounded-lg border border-champagne/15 bg-champagne/5 px-2.5 py-1.5 text-xs leading-relaxed text-champagne-light"><Icon name="shield" class="mt-0.5 h-3 w-3" />{section.verificationBadge}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
