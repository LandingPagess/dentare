---
import dentare from '../data/dentare.json';
import Icon from './Icon.astro';

const { clinic, footer, navigation, proceduresSection } = dentare;
const { instagram } = clinic.social;
const year = new Intl.DateTimeFormat('pt-BR', { year: 'numeric', timeZone: clinic.timeZone }).format(new Date());
---

<footer class="bg-navy-950 pb-8 pt-14 sm:pt-20">
  <div class="container">
    <section aria-labelledby="footer-clinical-title" class="mb-12 flex min-w-0 items-start gap-4 rounded-2xl border border-champagne/20 bg-gradient-to-br from-champagne/5 to-surface/70 p-5 sm:p-6">
      <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-champagne/30 bg-champagne/10 text-champagne-light"><Icon name="shield" /></span>
      <h2 id="footer-clinical-title" class="min-w-0 text-xl leading-relaxed text-ivory sm:text-2xl">
        {clinic.team.label}: <span class="mt-1 block font-sans text-sm leading-relaxed tracking-normal text-slate-200">{clinic.team.description}</span>
      </h2>
    </section>
    <div class="grid min-w-0 gap-10 border-b border-white/10 pb-12 md:grid-cols-2 lg:grid-cols-[1.3fr_0.8fr_1fr] lg:gap-12">
      <div class="min-w-0 max-w-sm">
        <a href="#inicio" aria-label={footer.backToTopLabel} class="inline-flex max-w-full items-center justify-center rounded-xl">
          <img
            src={clinic.logo.src}
            alt={clinic.name}
            width={clinic.logo.width}
            height={clinic.logo.height}
            loading="lazy"
            decoding="async"
            class="h-[150px] w-auto max-w-full rounded-xl object-contain"
          />
        </a>
        <p class="mt-6 text-sm leading-loose text-ivory-muted">{footer.description}</p>
        <div class="mt-6">
          <p class="text-xs font-semibold uppercase tracking-[0.06em] text-champagne-light">{footer.socialLabel}</p>
          <a href={instagram.url} target="_blank" rel="noopener noreferrer" aria-label={instagram.ariaLabel} class="group mt-3 inline-flex min-h-11 max-w-full items-center gap-3 text-xs text-slate-200 transition-colors hover:text-champagne-light">
            <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-champagne/20 text-champagne-light transition-colors group-hover:border-champagne/50 group-hover:bg-champagne/10"><Icon name="instagram" /></span>
            <span class="min-w-0 break-all">{instagram.handle}</span>
          </a>
        </div>
      </div>
      <nav aria-label={footer.navigationLabel}>
        <p class="text-xs font-semibold uppercase tracking-[0.06em] text-champagne-light">{footer.navigationLabel}</p>
        <ul class="mt-5 space-y-1">
          {[...navigation, footer.faqLink].map((link) => <li><a href={link.href} class="inline-flex min-h-11 items-center text-sm text-ivory-muted transition-colors hover:text-champagne-light">{link.label}</a></li>)}
        </ul>
      </nav>
      <div class="min-w-0">
        <p class="text-xs font-semibold uppercase tracking-[0.06em] text-champagne-light">{footer.contactLabel}</p>
        <address class="mt-6 text-sm not-italic leading-loose text-ivory-muted">{clinic.address.full}</address>
        <a href={clinic.contact.phoneHref} class="mt-3 inline-flex min-h-11 items-center gap-2 text-sm text-ivory transition-colors hover:text-champagne-light"><Icon name="message" class="h-4 w-4 text-champagne" />{clinic.contact.displayPhone}</a>
        <p class="mt-3 text-xs leading-loose text-ivory-muted">{clinic.hours.summary}</p>
      </div>
    </div>
    <div class="pt-7 text-xs leading-relaxed text-ivory-muted">
      <p>© {year} {clinic.name}. {footer.rightsReserved}</p>
      <p class="mt-3 max-w-3xl">{proceduresSection.note}</p>
      <details class="group mt-4 max-w-3xl">
        <summary class="inline-flex min-h-11 cursor-pointer list-none items-center gap-3 text-xs text-champagne-light hover:text-ivory [&::-webkit-details-marker]:hidden">{footer.privacyLabel}<Icon name="chevron" class="h-3.5 w-3.5 transition-transform group-open:rotate-180 motion-reduce:transition-none" /></summary>
        <p class="mt-2 leading-loose">{footer.privacyNotice}</p>
        <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-1">
          {footer.privacyLinks.map((link) => <li><a href={link.href} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center underline decoration-white/20 underline-offset-4 hover:text-champagne-light">{link.label}</a></li>)}
        </ul>
      </details>
    </div>
  </div>
</footer>
