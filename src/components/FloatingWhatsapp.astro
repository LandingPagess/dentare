---
import dentare from '../data/dentare.json';
import Icon from './Icon.astro';

const { clinic, floatingWhatsapp: content } = dentare;
const whatsappUrl = new URL(clinic.contact.whatsappBaseUrl);
whatsappUrl.searchParams.set('text', clinic.contact.defaultMessage);
const availability = JSON.stringify({
  timeZone: clinic.timeZone,
  schedule: clinic.hours.schedule,
  content,
}).replace(/</g, '\\u003c');
---

<div data-floating-whatsapp class="fixed bottom-[calc(1.5rem+env(safe-area-inset-bottom))] right-6 z-50 flex items-center gap-3 lg:bottom-6">
  <div class="pointer-events-none hidden lg:block max-w-[calc(100vw-7.5rem)] rounded-2xl border border-white/10 bg-slate-900/95 px-3 py-2.5 text-xs leading-relaxed text-ivory shadow-premium backdrop-blur-md sm:max-w-[14rem] sm:px-4">
    <span data-whatsapp-status class="block text-surgical" aria-live="polite">{content.defaultStatus}</span>
    <span class="block font-semibold">{content.label}</span>
  </div>
  <a href={whatsappUrl.href} aria-label={content.ariaLabel} class="relative inline-flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg transition-colors hover:bg-[#5BE58E] focus-visible:outline-champagne motion-reduce:transition-none">
    <Icon name="whatsapp" class="relative h-10 w-10" />
  </a>
</div>
<script is:inline id="whatsapp-availability" type="application/json" set:html={availability} />

<script>
  const statusElement = document.querySelector<HTMLElement>('[data-whatsapp-status]');
  const configElement = document.getElementById('whatsapp-availability');
  if (statusElement && configElement?.textContent) {
    const config = JSON.parse(configElement.textContent) as {
      timeZone: string;
      schedule: Array<{ dayOfWeek: string[]; opens: string; closes: string }>;
      content: { confirmedOnline: boolean | null; onlineStatus: string; businessHoursStatus: string; awayStatus: string };
    };
    const timeInMinutes = (time: string) => {
      const [hours, minutes] = time.split(':').map(Number);
      return hours * 60 + minutes;
    };
    const updateStatus = () => {
      if (config.content.confirmedOnline === true) {
        statusElement.textContent = config.content.onlineStatus;
        return;
      }
      const parts = new Intl.DateTimeFormat('en-US', {
        timeZone: config.timeZone, weekday: 'long', hour: '2-digit', minute: '2-digit', hourCycle: 'h23',
      }).formatToParts(new Date());
      const part = (type: string) => parts.find((item) => item.type === type)?.value ?? '';
      const now = Number(part('hour')) * 60 + Number(part('minute'));
      const isBusinessHours = config.schedule.some((item) => item.dayOfWeek.includes(part('weekday')) && now >= timeInMinutes(item.opens) && now < timeInMinutes(item.closes));
      statusElement.textContent = isBusinessHours ? config.content.businessHoursStatus : config.content.awayStatus;
    };
    updateStatus();
    window.setInterval(updateStatus, 60_000);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) updateStatus(); });
  }

  const floatingButton = document.querySelector<HTMLElement>('[data-floating-whatsapp]');
  if (floatingButton) {
    const mobile = window.matchMedia('(max-width: 1023px)');
    const actions = Array.from(document.querySelectorAll<HTMLElement>('a[href], button, summary, input:not([type="hidden"]), select, textarea, iframe, [role="button"]'))
      .filter((action) => !floatingButton.contains(action));
    let updatePending = false;

    const updateOverlap = () => {
      updatePending = false;
      if (!mobile.matches) {
        floatingButton.removeAttribute('data-obstructed');
        return;
      }
      const bounds = floatingButton.getBoundingClientRect();
      const overlapsAction = actions.some((action) => {
        if (!action.getClientRects().length || getComputedStyle(action).visibility === 'hidden') return false;
        const rect = action.getBoundingClientRect();
        return rect.right > bounds.left - 8 && rect.left < bounds.right + 8
          && rect.bottom > bounds.top - 8 && rect.top < bounds.bottom + 8;
      });
      floatingButton.toggleAttribute('data-obstructed', overlapsAction);
    };

    const scheduleUpdate = () => {
      if (updatePending) return;
      updatePending = true;
      window.requestAnimationFrame(updateOverlap);
    };

    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate, { passive: true });
    window.visualViewport?.addEventListener('resize', scheduleUpdate, { passive: true });
    mobile.addEventListener('change', scheduleUpdate);
    document.addEventListener('toggle', scheduleUpdate, true);
    document.fonts.ready.then(scheduleUpdate);
    new ResizeObserver(scheduleUpdate).observe(document.body);
    updateOverlap();
  }
</script>

<style>
  @media (max-width: 1023px) {
    [data-floating-whatsapp][data-obstructed] {
      visibility: hidden;
      pointer-events: none;
    }
  }
</style>
