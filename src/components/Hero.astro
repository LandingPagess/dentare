---
import dentare from '../data/dentare.json';
import Icon from './Icon.astro';

const { clinic, hero } = dentare;
const whatsappUrl = new URL(clinic.contact.whatsappBaseUrl);
whatsappUrl.searchParams.set('text', hero.primaryCta.whatsappMessage);
const hasAccent = hero.headline.endsWith(hero.headlineAccent);
const headlineLead = hasAccent ? hero.headline.slice(0, -hero.headlineAccent.length).trim() : hero.headline;
---

<section id="inicio" aria-labelledby="hero-title" class="relative isolate overflow-hidden border-b border-white/10 bg-background pb-16 pt-32 sm:pb-24 sm:pt-40 xl:pt-48">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-premium-radial"></div>
  <div aria-hidden="true" class="pointer-events-none absolute right-0 top-40 -z-10 h-[36rem] w-1/2 rounded-full bg-surgical/5 blur-3xl"></div>
  <div class="container grid min-w-0 items-center gap-14 lg:grid-cols-[1.15fr_1fr] lg:gap-10 xl:gap-16">
    <div class="min-w-0">
      <div class="mb-8 inline-flex max-w-full flex-wrap items-center gap-x-2 gap-y-1 rounded-2xl border border-champagne/20 bg-champagne/5 px-4 py-3 text-[10px] leading-relaxed tracking-wide text-ivory-muted backdrop-blur-md sm:text-[11px]">
        <span class="inline-flex shrink-0 items-center gap-1.5 font-semibold text-champagne-light"><Icon name="star" class="h-3 w-3" />{clinic.google.rating} {hero.authority.ratingLabel}</span>
        <span aria-hidden="true" class="text-champagne/50">•</span>
        <span>{hero.authority.socialProof}</span>
      </div>
      <p class="mb-5 flex items-center gap-3 text-[10px] font-semibold uppercase tracking-eyebrow text-surgical sm:text-xs">
        <span aria-hidden="true" class="h-px w-7 shrink-0 bg-surgical/60"></span>{hero.eyebrow}
      </p>
      <h1 id="hero-title" class="max-w-3xl font-display text-[clamp(2.5rem,4.6vw,4.5rem)] leading-[1.08] tracking-display text-ivory">
        {headlineLead}{' '}
        {hasAccent && <span class="mt-2 block italic text-champagne-light">{hero.headlineAccent}</span>}
      </h1>
      <p class="mt-7 max-w-xl text-[15px] leading-[1.9] text-ivory-muted sm:text-base">{hero.subtitle}</p>
      <div class="mt-9 flex flex-col items-stretch gap-5 sm:items-start">
        <a href={whatsappUrl.href} class="group inline-flex min-h-14 items-center justify-center gap-3 rounded-full bg-champagne px-6 py-4 text-center text-[13px] font-semibold text-navy-950 shadow-glow transition-colors hover:bg-champagne-light sm:px-7">
          <Icon name="message" class="h-[18px] w-[18px]" />
          {hero.primaryCta.label}
          <Icon name="arrow" class="ml-1 h-4 w-4 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 motion-reduce:transform-none" />
        </a>
        <a href={hero.secondaryCta.href} class="group inline-flex min-h-11 items-center justify-center gap-3 self-center border-b border-white/20 text-[13px] font-medium text-ivory transition-colors hover:border-champagne hover:text-champagne sm:self-start">
          {hero.secondaryCta.label}<Icon name="down" class="h-4 w-4 text-champagne" />
        </a>
      </div>
      <p class="mt-7 max-w-md text-[11px] leading-relaxed text-ivory-muted">{hero.reassurance}</p>
    </div>

    <figure class="relative mx-auto w-full min-w-0 max-w-lg pb-9 lg:pb-8">
      <div class="relative overflow-hidden rounded-[2rem] border border-white/10 bg-gradient-to-br from-surface-raised via-surface to-background p-6 shadow-premium sm:p-8">
        <div class="relative z-10 flex items-start justify-between gap-4">
          <div>
            <p class="text-[9px] font-medium uppercase tracking-eyebrow text-champagne">{hero.visual.eyebrow}</p>
            <p class="mt-3 max-w-[16rem] font-display text-2xl leading-snug text-ivory sm:text-[1.8rem]">{hero.visual.title}</p>
          </div>
          <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/10 text-champagne"><Icon name="sparkle" class="h-[18px] w-[18px]" /></span>
        </div>
        <div class="relative -mx-4 -mb-4 mt-3 sm:-mx-6">
          <span aria-hidden="true" class="absolute right-6 top-2 font-sans text-7xl font-semibold tracking-tighter text-white/[0.035] sm:text-8xl">{hero.visual.watermark}</span>
          <svg viewBox="0 0 400 430" class="relative block h-auto w-full" fill="none" aria-hidden="true" focusable="false">
            <defs>
              <linearGradient id="dentare-tooth" x1="110" y1="93" x2="290" y2="340" gradientUnits="userSpaceOnUse">
                <stop stop-color="#FAF7F0" /><stop offset=".35" stop-color="#E8DECD" /><stop offset=".65" stop-color="#B9AE9B" /><stop offset="1" stop-color="#716D65" />
              </linearGradient>
              <linearGradient id="dentare-edge" x1="116" y1="115" x2="270" y2="293" gradientUnits="userSpaceOnUse">
                <stop stop-color="white" stop-opacity=".85" /><stop offset="1" stop-color="white" stop-opacity="0" />
              </linearGradient>
              <radialGradient id="dentare-halo"><stop stop-color="#8FBDB7" stop-opacity=".12" /><stop offset="1" stop-color="#8FBDB7" stop-opacity="0" /></radialGradient>
              <pattern id="dentare-grid" width="28" height="28" patternUnits="userSpaceOnUse"><path d="M28 0H0v28" stroke="#8FBDB7" stroke-opacity=".06" stroke-width=".7" /></pattern>
              <filter id="dentare-shadow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="12" /></filter>
            </defs>
            <rect x="16" y="10" width="368" height="400" fill="url(#dentare-grid)" />
            <ellipse cx="200" cy="216" rx="178" ry="185" fill="url(#dentare-halo)" />
            <ellipse cx="200" cy="370" rx="76" ry="12" fill="#000" opacity=".4" filter="url(#dentare-shadow)" />
            <ellipse cx="200" cy="227" rx="164" ry="63" stroke="#8FBDB7" stroke-opacity=".17" transform="rotate(-24 200 227)" />
            <ellipse cx="200" cy="227" rx="167" ry="66" stroke="#C5A880" stroke-opacity=".15" transform="rotate(24 200 227)" />
            <path d="M175 105C140 65 102 78 85 118C65 165 88 207 110 244C125 273 129 326 153 351C163 362 179 346 180 322L190 268C195 251 205 251 210 268L220 322C223 346 237 362 247 351C271 325 275 273 290 244C316 206 333 164 314 118C297 78 260 65 225 105C211 114 189 114 175 105Z" fill="url(#dentare-tooth)" />
            <path d="M175 105C140 65 102 78 85 118C65 165 88 207 110 244C125 273 129 326 153 351C163 362 179 346 180 322L190 268C195 251 205 251 210 268L220 322C223 346 237 362 247 351C271 325 275 273 290 244C316 206 333 164 314 118C297 78 260 65 225 105C211 114 189 114 175 105Z" stroke="url(#dentare-edge)" stroke-width="1.4" />
            <path d="M110 119C98 146 109 178 124 202C137 224 143 249 149 275" stroke="white" stroke-opacity=".3" stroke-width="8" stroke-linecap="round" />
            <path d="M167 124C185 139 215 139 235 122M200 137l-2 64" stroke="#7B7368" stroke-opacity=".35" stroke-width="2" stroke-linecap="round" />
            <path d="M88 174C142 159 251 160 313 177M94 190C155 175 252 179 307 193M104 207C159 194 246 197 299 210M113 223C162 213 243 214 289 225" stroke="#8FBDB7" stroke-opacity=".45" stroke-width=".8" />
            <path d="M41 173h39M320 173h39M200 43v29M200 378v24" stroke="#8FBDB7" stroke-opacity=".4" />
            <path d="M43 113V91h22M335 91h22v22M43 297v22h22M335 319h22v-22" stroke="#C5A880" stroke-opacity=".55" stroke-width="1.2" />
            <circle cx="103" cy="190" r="4" fill="#8FBDB7" /><circle cx="103" cy="190" r="9" stroke="#8FBDB7" stroke-opacity=".4" />
            <path d="M94 190H58v52H31" stroke="#8FBDB7" stroke-opacity=".5" stroke-width=".8" />
            <circle cx="288" cy="223" r="4" fill="#C5A880" /><circle cx="288" cy="223" r="9" stroke="#C5A880" stroke-opacity=".4" />
            <path d="M297 223h39v-71h37" stroke="#C5A880" stroke-opacity=".5" stroke-width=".8" />
          </svg>
        </div>
        <div class="flex items-center justify-between gap-3 border-t border-white/10 pt-4 text-[9px] uppercase tracking-[0.12em] text-ivory-muted sm:text-[10px]">
          <span class="flex items-center gap-2"><span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-surgical"></span>{hero.visual.status}</span>
          <span class="text-champagne">{clinic.shortName}</span>
        </div>
        <figcaption class="mt-3 text-[9px] text-ivory-muted">{hero.visual.caption}</figcaption>
      </div>
      <div class="absolute bottom-0 right-3 flex max-w-[calc(100%-1.5rem)] items-center gap-3 rounded-2xl border border-champagne/25 bg-navy-800/85 px-5 py-4 shadow-premium backdrop-blur-md sm:right-5 sm:gap-4 sm:px-6">
        <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-champagne/20 bg-champagne/10 text-champagne"><Icon name="scan" class="h-6 w-6" /></span>
        <span class="text-xs leading-relaxed sm:text-sm"><span class="block text-champagne-light">{hero.visual.sealTitle}</span><span class="font-semibold text-ivory">{hero.visual.sealSubtitle}</span></span>
      </div>
    </figure>
  </div>
  <div class="container mt-14 flex flex-wrap items-center justify-between gap-x-8 gap-y-3 border-t border-white/10 pt-6 text-[10px] font-medium uppercase tracking-[0.14em] text-ivory-muted sm:mt-20 sm:text-[11px]">
    <span class="flex items-center gap-2"><Icon name="sparkle" class="h-3.5 w-3.5 text-champagne" />{hero.visual.footerLabel}</span>
    <span>{hero.visual.footerDetail}</span>
  </div>
</section>
