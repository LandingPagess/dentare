---
import dentare from '../data/dentare.json';
import Icon from './Icon.astro';

const { clinic, hero } = dentare;
const image = hero.visual.image;
const imageSources = image.sources.map((source) => `${source.src} ${source.width}w`).join(', ');
const whatsappUrl = new URL(clinic.contact.whatsappBaseUrl);
whatsappUrl.searchParams.set('text', hero.primaryCta.whatsappMessage);
const hasAccent = hero.headline.endsWith(hero.headlineAccent);
const headlineLead = hasAccent ? hero.headline.slice(0, -hero.headlineAccent.length).trim() : hero.headline;
---

<section id="inicio" aria-labelledby="hero-title" class="relative isolate overflow-hidden bg-background pb-16 pt-28 sm:pb-24 sm:pt-40 xl:pt-48">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-premium-radial"></div>
  <div aria-hidden="true" class="pointer-events-none absolute right-0 top-40 -z-10 h-[36rem] w-1/2 rounded-full bg-surgical/5 blur-3xl"></div>
  <div class="container grid min-w-0 items-center gap-10 sm:gap-14 lg:grid-cols-[1.08fr_1fr] lg:gap-10 xl:gap-16">
    <div class="flex min-w-0 flex-col">
      <div class="order-6 mt-6 inline-flex sm:order-none sm:mb-8 sm:mt-0 max-w-full flex-wrap items-center gap-x-2 gap-y-1 rounded-2xl border border-champagne/20 bg-champagne/5 px-4 py-3 text-xs leading-relaxed tracking-wide text-ivory-muted backdrop-blur-md">
        <Icon name="star" class="h-4 w-4 text-champagne-light" />
        <span class="min-w-0 font-semibold text-champagne-light">{clinic.google.summary}</span>
      </div>
      <p class="hidden items-center gap-3 sm:mb-5 sm:flex text-xs font-semibold uppercase tracking-eyebrow text-surgical">
        <span aria-hidden="true" class="h-px w-7 shrink-0 bg-surgical/60"></span>{hero.eyebrow}
      </p>
      <h1 id="hero-title" class="order-1 max-w-3xl font-display text-[clamp(1.875rem,8vw,2.5rem)] sm:order-none sm:text-[clamp(2.5rem,4.2vw,4.25rem)] leading-[1.08] tracking-display text-ivory">
        {headlineLead}{' '}
        {hasAccent && <span class="mt-2 block italic text-champagne-light">{hero.headlineAccent}</span>}
      </h1>
      <p class="order-2 mt-4 max-w-xl text-xs font-semibold leading-relaxed text-champagne-light sm:order-none sm:mt-5 sm:text-sm">{hero.treatmentFocus}</p>
      <p class="order-4 mt-5 max-w-xl text-sm leading-relaxed text-slate-300 sm:order-none sm:mt-7 sm:text-base sm:leading-[1.9]">{hero.subtitle}</p>
      <div class="order-3 mt-5 flex flex-col items-stretch gap-3 sm:order-none sm:mt-9 sm:items-start sm:gap-5">
        <a href={whatsappUrl.href} class="group inline-flex min-h-14 items-center justify-center gap-3 rounded-full bg-champagne px-6 py-4 text-center text-[13px] font-semibold text-navy-950 shadow-glow transition-colors hover:bg-champagne-light sm:px-7">
          <Icon name="whatsapp" class="h-5 w-5" />
          {hero.primaryCta.label}
          <Icon name="arrow" class="ml-1 h-4 w-4 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 motion-reduce:transform-none" />
        </a>
        <a href={hero.secondaryCta.href} class="group inline-flex min-h-11 items-center justify-center gap-3 self-center border-b border-white/20 text-[13px] font-medium text-ivory transition-colors hover:border-champagne hover:text-champagne sm:self-start">
          {hero.secondaryCta.label}<Icon name="down" class="h-4 w-4 text-champagne" />
        </a>
      </div>
      <p class="order-5 mt-5 max-w-md text-xs leading-relaxed text-slate-300 sm:order-none sm:mt-7">{hero.reassurance}</p>
    </div>

    <figure class="relative mx-auto w-full min-w-0 max-w-xl pb-16 lg:pb-14">
      <div aria-hidden="true" class="pointer-events-none absolute -inset-5 -z-10 rounded-full bg-champagne/10 blur-3xl"></div>
      <div class="relative aspect-[4/5] overflow-hidden rounded-[2rem] border border-white/20 bg-surface shadow-[0_28px_80px_-20px_rgba(0,0,0,0.65)] ring-1 ring-inset ring-champagne/10 sm:aspect-[5/6] lg:aspect-[4/5] lg:rounded-[3rem]">
        <img
          src={image.src}
          srcset={imageSources}
          sizes="(min-width: 1440px) 560px, (min-width: 1024px) 45vw, (min-width: 640px) 576px, calc(100vw - 3rem)"
          width={image.width}
          height={image.height}
          alt={image.alt}
          fetchpriority="high"
          loading="eager"
          decoding="async"
          style={{ objectPosition: image.position }}
          class="absolute inset-0 h-full w-full object-cover saturate-[0.8]"
        />
        <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-t from-navy-950/95 via-navy-950/5 to-navy-950/15"></div>
        <p class="absolute left-5 top-5 hidden max-w-[calc(100%-2.5rem)] items-center gap-2 rounded-full border border-white/20 bg-navy-950/30 px-3 py-2 text-xs uppercase tracking-[0.06em] text-ivory backdrop-blur-xl sm:left-7 sm:top-7 sm:flex">
          <Icon name="sparkle" class="h-3.5 w-3.5 text-champagne-light" />{hero.visual.eyebrow}
        </p>
        <p class="absolute bottom-28 left-8 right-8 hidden max-w-sm font-display text-4xl italic leading-tight text-ivory sm:block">{hero.visual.title}</p>
      </div>
      <div class="absolute bottom-10 left-3 right-3 flex items-center gap-3 rounded-2xl border border-amber-300/20 bg-slate-900/70 px-4 py-5 shadow-2xl backdrop-blur-xl sm:left-6 sm:right-6 sm:gap-4 sm:px-6 lg:-left-6 lg:right-6">
        <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-champagne/30 bg-champagne/10 text-champagne-light sm:h-12 sm:w-12"><Icon name="award" class="h-7 w-7" /></span>
        <span class="min-w-0"><span class="block font-display text-base leading-snug text-champagne-light sm:text-xl">{hero.visual.sealTitle}</span><span class="mt-1 block text-xs leading-relaxed text-ivory-muted">{hero.visual.sealSubtitle}</span></span>
      </div>
      <figcaption class="absolute bottom-0 left-0 max-w-full text-xs leading-relaxed text-slate-300">{hero.visual.caption}</figcaption>
    </figure>
  </div>
  <div class="container mt-14 flex flex-wrap items-center justify-between gap-x-8 gap-y-3 border-t border-white/10 pt-6 text-xs font-medium uppercase tracking-[0.06em] text-ivory-muted sm:mt-20">
    <span class="flex items-center gap-2"><Icon name="sparkle" class="h-3.5 w-3.5 text-champagne" />{hero.visual.footerLabel}</span>
    <span>{hero.visual.footerDetail}</span>
  </div>
</section>
