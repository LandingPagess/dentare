---
import dentare from '../data/dentare.json';
import Icon from './Icon.astro';

const { clinic, proceduresSection: section, procedures } = dentare;
const icons: Record<string, 'implant' | 'aligners' | 'restoration' | 'sparkle'> = {
  'implantes-guiados': 'implant',
  'alinhadores-invisiveis': 'aligners',
  'reabilitacao-oral': 'restoration',
  'estetica-do-sorriso': 'sparkle',
};
const consultationUrl = (message: string) => {
  const url = new URL(clinic.contact.whatsappBaseUrl);
  url.searchParams.set('text', message);
  return url.href;
};
---

<section id="procedimentos" aria-labelledby="procedures-title" class="relative isolate py-20 sm:py-24 lg:py-28">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-premium-radial opacity-60"></div>
  <div class="container">
    <div class="max-w-3xl">
      <p class="inline-flex max-w-full items-center gap-2 rounded-full border border-champagne/20 bg-champagne/5 px-4 py-2 text-xs font-semibold uppercase tracking-eyebrow text-champagne-light">
        <Icon name="sparkle" class="h-3.5 w-3.5" />{section.eyebrow}
      </p>
      <h2 id="procedures-title" class="mt-6 text-display-lg text-ivory">{section.title}</h2>
      <p class="mt-5 max-w-2xl text-sm leading-loose text-slate-200 sm:text-base">{section.description}</p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-2 lg:mt-12 lg:gap-6">
      {procedures.map((procedure, index) => (
        <article aria-labelledby={`procedure-${procedure.id}`} class="group relative flex min-w-0 flex-col overflow-hidden rounded-[2rem] border border-white/10 bg-surface/80 p-6 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-gold/30 hover:shadow-premium focus-within:border-gold/30 motion-reduce:transform-none motion-reduce:transition-none sm:p-8 lg:p-10">
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-br from-champagne/10 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-within:opacity-100 motion-reduce:transition-none"></div>
          <div class="relative flex items-center justify-between gap-4">
            <span class="inline-flex h-14 w-14 items-center justify-center rounded-2xl border border-champagne/20 bg-champagne/5 text-champagne-light transition-colors duration-300 group-hover:bg-champagne/10 motion-reduce:transition-none">
              <Icon name={icons[procedure.id] ?? 'sparkle'} class="h-7 w-7" />
            </span>
            <span aria-hidden="true" class="font-display text-4xl italic text-champagne/20 transition-colors duration-300 group-hover:text-champagne/40 motion-reduce:transition-none">{String(index + 1).padStart(2, '0')}</span>
          </div>
          <p class="relative mt-7 inline-flex max-w-full items-center gap-2 self-start rounded-full border border-surgical/20 bg-surgical/5 px-3 py-1.5 text-xs font-medium uppercase tracking-[0.06em] text-surgical">
            <span aria-hidden="true" class="h-1 w-1 shrink-0 rounded-full bg-surgical"></span>{procedure.category}
          </p>
          <h3 id={`procedure-${procedure.id}`} class="relative mt-3 max-w-lg text-2xl leading-snug text-ivory sm:text-[1.75rem]">{procedure.title}</h3>
          <p class="relative mt-4 text-sm leading-loose text-slate-200">{procedure.summary}</p>
          <ul class="relative mb-8 mt-6 space-y-3">
            {procedure.benefits.map((benefit) => (
              <li class="flex items-start gap-3 text-[13px] leading-relaxed text-slate-200">
                <span class="mt-0.5 inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-champagne/10 text-champagne"><Icon name="check" class="h-3 w-3" /></span>
                <span class="min-w-0">{benefit}</span>
              </li>
            ))}
          </ul>
          <div class="relative mt-auto flex flex-col items-start border-t border-white/10 pt-5">
            <a href={consultationUrl(procedure.whatsappMessage)} aria-label={`${section.quickActionAccessibleLabel} ${procedure.title}`} class="group/action inline-flex min-h-12 max-w-full items-center gap-3 text-left text-xs font-semibold leading-relaxed text-champagne-light transition-colors hover:text-ivory focus-visible:text-ivory sm:text-[13px]">
              <Icon name="whatsapp" /><span class="min-w-0">{procedure.ctaLabel}</span>
              <Icon name="arrow" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1 group-focus-within:translate-x-1 motion-reduce:transform-none motion-reduce:transition-none" />
            </a>
          </div>
        </article>
      ))}
    </div>
    <p class="mt-7 max-w-3xl text-xs leading-relaxed text-slate-200">{section.note}</p>
  </div>
</section>
