---
import dentare from '../data/dentare.json';
import Icon from './Icon.astro';

const { differentialsSection: section, differentials } = dentare;
const [featured, ...compact] = differentials;
const icons: Record<string, 'shield' | 'heart' | 'clock'> = {
  conforto: 'shield',
  'atendimento-humanizado': 'heart',
  pontualidade: 'clock',
};
---

<section id="diferenciais" aria-labelledby="differentials-title" class="relative isolate py-20 sm:py-24 lg:py-28">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-surface/40 to-background"></div>
  <div class="container">
    <div class="max-w-3xl">
      <p class="flex items-center gap-3 text-eyebrow uppercase text-champagne"><span aria-hidden="true" class="h-px w-8 shrink-0 bg-champagne/50"></span>{section.eyebrow}</p>
      <h2 id="differentials-title" class="mt-5 text-display-lg text-ivory">{section.title}</h2>
      <p class="mt-5 max-w-2xl text-sm leading-loose text-slate-200 sm:text-base">{section.description}</p>
    </div>

    <div class="mt-10 grid min-w-0 grid-cols-1 gap-4 sm:grid-cols-2 lg:mt-12 lg:grid-cols-12 lg:gap-5">
      <article aria-labelledby={`differential-${featured.id}`} class="relative flex min-w-0 flex-col overflow-hidden rounded-[2rem] border border-champagne/25 bg-gradient-to-br from-champagne/10 via-surface to-navy-950 p-7 shadow-premium sm:col-span-2 sm:p-9 lg:col-span-7 lg:row-span-3 lg:p-10">
        <div aria-hidden="true" class="pointer-events-none absolute -right-24 top-20 h-80 w-80 rounded-full border border-champagne/10 p-8"><div class="h-full w-full rounded-full border border-champagne/10 p-8"><div class="h-full w-full rounded-full border border-champagne/10"></div></div></div>
        <div class="relative flex items-center gap-3">
          <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-champagne/25 bg-champagne/10 text-champagne-light"><Icon name="scan" class="h-6 w-6" /></span>
          <p class="text-xs font-semibold uppercase tracking-[0.06em] text-champagne-light">{section.featuredEyebrow}</p>
        </div>
        <h3 id={`differential-${featured.id}`} class="relative mt-7 max-w-sm font-display text-3xl leading-tight text-ivory sm:text-4xl">{featured.title}</h3>
        <p class="relative mt-5 max-w-lg text-sm leading-loose text-slate-200">{featured.description}</p>
        <div class="relative my-8 flex flex-wrap items-end gap-x-5 gap-y-3 sm:my-9">
          <span class="font-display text-8xl leading-none tracking-[-0.06em] text-champagne-light sm:text-9xl">{featured.number}</span>
          <p class="max-w-[10rem] pb-1 text-xs leading-relaxed text-champagne-light">{section.featuredMetricLabel}</p>
        </div>
        <ol aria-label={section.featuredStepsLabel} class="relative mt-auto grid gap-4 border-t border-champagne/15 pt-6 sm:grid-cols-3">
          {section.featuredSteps.map((step) => <li class="flex items-baseline gap-3 sm:block"><span class="text-xs tracking-wide text-champagne">{step.number}</span><span class="text-xs leading-relaxed text-slate-300 sm:mt-2 sm:block">{step.label}</span></li>)}
        </ol>
      </article>
      {compact.map((item) => (
        <article aria-labelledby={`differential-${item.id}`} class="group relative flex min-w-0 items-start gap-5 overflow-hidden rounded-3xl border border-white/5 bg-slate-900/50 p-6 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-champagne/25 last:sm:col-span-2 lg:col-span-5 lg:p-7 last:lg:col-span-5 motion-reduce:transform-none motion-reduce:transition-none">
          <span aria-hidden="true" class="pointer-events-none absolute right-5 top-2 font-display text-7xl italic leading-none text-champagne/[0.06]">{item.number}</span>
          <span class="relative inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-champagne/15 bg-champagne/5 text-champagne-light transition-colors group-hover:bg-champagne/10"><Icon name={icons[item.id] ?? 'shield'} class="h-5 w-5" /></span>
          <div class="relative min-w-0">
            <h3 id={`differential-${item.id}`} class="text-xl leading-snug text-ivory">{item.title}</h3>
            <p class="mt-3 text-xs leading-loose text-slate-200 sm:text-[13px]">{item.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
