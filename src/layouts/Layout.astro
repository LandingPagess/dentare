---
import dentare from '../data/dentare.json';
import plusJakartaSansUrl from '../assets/fonts/plus-jakarta-sans-latin-variable.woff2?url';
import playfairDisplayUrl from '../assets/fonts/playfair-display-latin-variable.woff2?url';

interface Props {
  title?: string;
  description?: string;
  canonical?: string | URL;
  socialImage?: string | URL;
  socialImageAlt?: string;
  class?: string;
  bodyClass?: string;
}

const {
  title = dentare.seo.title,
  description = dentare.seo.description,
  canonical,
  socialImage,
  socialImageAlt = dentare.clinic.name,
  class: className,
  bodyClass,
} = Astro.props;

const canonicalUrl = canonical
  ? new URL(canonical, Astro.site ?? Astro.url)
  : Astro.site
    ? new URL(Astro.url.pathname, Astro.site)
    : undefined;

if (canonicalUrl) {
  canonicalUrl.search = '';
  canonicalUrl.hash = '';
}

const imageUrl = new URL(socialImage ?? dentare.seo.social.image, canonicalUrl ?? Astro.site ?? dentare.seo.siteUrl);
const sharingTitle = title === dentare.seo.title ? dentare.seo.social.title : title;
const sharingDescription = description === dentare.seo.description ? dentare.seo.social.description : description;
const sharingImageAlt = socialImage ? socialImageAlt : dentare.seo.social.imageAlt;
const heroImage = dentare.hero.visual.image;
const heroImageSources = heroImage.sources.map((source) => `${source.src} ${source.width}w`).join(', ');

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Dentist',
  name: dentare.clinic.name,
  description: dentare.seo.description,
  ...(canonicalUrl && { url: canonicalUrl.href }),
  telephone: `+${dentare.clinic.contact.whatsapp}`,
  sameAs: [dentare.clinic.social.instagram.url],
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${dentare.clinic.address.street}, ${dentare.clinic.address.block}, ${dentare.clinic.address.lot}, ${dentare.clinic.address.complement}, ${dentare.clinic.address.neighborhood}`,
    addressLocality: dentare.clinic.address.city,
    addressRegion: dentare.clinic.address.state,
    addressCountry: dentare.clinic.address.country,
  },
  areaServed: dentare.clinic.serviceAreas.map((name) => ({ '@type': 'Place', name })),
  openingHoursSpecification: dentare.clinic.hours.schedule.map((schedule) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: schedule.dayOfWeek.map((day) => `https://schema.org/${day}`),
    opens: schedule.opens,
    closes: schedule.closes,
  })),
};

const serializedStructuredData = JSON.stringify(structuredData).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      as="image"
      href={heroImage.src}
      imagesrcset={heroImageSources}
      imagesizes={heroImage.sizes}
      fetchpriority="high"
    />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href={dentare.clinic.logo.icon.src} sizes={`${dentare.clinic.logo.icon.width}x${dentare.clinic.logo.icon.height}`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content={dentare.seo.themeColor} />
    <meta name="format-detection" content="telephone=no" />
    <meta name="geo.region" content="BR-BA" />
    <meta name="geo.placename" content="Vilas do Atlântico, Lauro de Freitas, Bahia" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl.href} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={dentare.seo.locale} />
    <meta property="og:site_name" content={dentare.clinic.name} />
    <meta property="og:title" content={sharingTitle} />
    <meta property="og:description" content={sharingDescription} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl.href} />}
    <meta property="og:image" content={imageUrl.href} />
    <meta property="og:image:alt" content={sharingImageAlt} />
    {!socialImage && <meta property="og:image:type" content={dentare.seo.social.imageType} />}
    {!socialImage && <meta property="og:image:width" content={String(dentare.seo.social.imageWidth)} />}
    {!socialImage && <meta property="og:image:height" content={String(dentare.seo.social.imageHeight)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={sharingTitle} />
    <meta name="twitter:description" content={sharingDescription} />
    <meta name="twitter:image" content={imageUrl.href} />
    <meta name="twitter:image:alt" content={sharingImageAlt} />
    <link rel="preload" href={plusJakartaSansUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={playfairDisplayUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <script is:inline type="application/ld+json" set:html={serializedStructuredData} />
  </head>
  <body class:list={['min-h-screen bg-background font-sans text-ivory antialiased', className, bodyClass]}>
    <slot />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'Plus Jakarta Sans';
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
    src: url('../assets/fonts/plus-jakarta-sans-latin-variable.woff2') format('woff2');
  }
  @font-face {
    font-family: 'Playfair Display';
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
    src: url('../assets/fonts/playfair-display-latin-variable.woff2') format('woff2');
  }

  @tailwind base;
  @tailwind components;
  @tailwind utilities;

  @layer base {
    :root { color-scheme: dark; }
    html { scroll-behavior: smooth; scroll-padding-top: 5rem; scrollbar-gutter: stable; }
    body { margin: 0; line-height: 1.75; }
    @media (max-width: 1023px) {
      body:has([data-floating-whatsapp]) { padding-bottom: calc(6rem + env(safe-area-inset-bottom)); }
    }
    h1, h2, h3, h4, h5, h6 {
      font-family: 'Playfair Display', ui-serif, Georgia, serif;
      font-weight: 500;
      line-height: 1.15;
      letter-spacing: -0.025em;
      text-wrap: balance;
    }
    p { text-wrap: pretty; }
    ::selection { background: #C5A880; color: #0A0F1D; }
    :focus-visible { outline: 2px solid #C5A880; outline-offset: 4px; }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }
  }
</style>
